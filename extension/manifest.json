{
  "manifest_version": 3,
  "name": "ADB Site Filter",
  "version": "0.1.0",
  "description": "Site-scoped network blocking and cosmetic hiding for adb test sites.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://learncpp.com/*",
    "*://*.learncpp.com/*",
    "*://ezojs.com/*",
    "*://*.ezojs.com/*",
    "*://ezoic.net/*",
    "*://*.ezoic.net/*",
    "*://ezodn.com/*",
    "*://*.ezodn.com/*",
    "*://ezoiccdn.com/*",
    "*://*.ezoiccdn.com/*",
    "*://ezoic.com/*",
    "*://*.ezoic.com/*",
    "*://optable.co/*",
    "*://*.optable.co/*",
    "*://doubleclick.net/*",
    "*://*.doubleclick.net/*",
    "*://googlesyndication.com/*",
    "*://*.googlesyndication.com/*",
    "*://googleadservices.com/*",
    "*://*.googleadservices.com/*",
    "*://adservice.google.com/*",
    "*://google-analytics.com/*",
    "*://*.google-analytics.com/*",
    "*://googletagmanager.com/*",
    "*://*.googletagmanager.com/*",
    "*://googletagservices.com/*",
    "*://*.googletagservices.com/*",
    "*://adnxs.com/*",
    "*://*.adnxs.com/*",
    "*://adsrvr.org/*",
    "*://*.adsrvr.org/*",
    "*://criteo.com/*",
    "*://*.criteo.com/*",
    "*://criteo.net/*",
    "*://*.criteo.net/*",
    "*://pubmatic.com/*",
    "*://*.pubmatic.com/*",
    "*://rubiconproject.com/*",
    "*://*.rubiconproject.com/*",
    "*://openx.net/*",
    "*://*.openx.net/*",
    "*://taboola.com/*",
    "*://*.taboola.com/*",
    "*://outbrain.com/*",
    "*://*.outbrain.com/*",
    "*://scorecardresearch.com/*",
    "*://*.scorecardresearch.com/*",
    "*://quantserve.com/*",
    "*://*.quantserve.com/*",
    "*://moatads.com/*",
    "*://*.moatads.com/*",
    "*://amazon-adsystem.com/*",
    "*://*.amazon-adsystem.com/*",
    "*://media.net/*",
    "*://*.media.net/*",
    "*://sharethrough.com/*",
    "*://*.sharethrough.com/*",
    "*://33across.com/*",
    "*://*.33across.com/*",
    "*://indexww.com/*",
    "*://*.indexww.com/*",
    "*://casalemedia.com/*",
    "*://*.casalemedia.com/*",
    "*://smartadserver.com/*",
    "*://*.smartadserver.com/*",
    "*://teads.tv/*",
    "*://*.teads.tv/*",
    "*://adform.net/*",
    "*://*.adform.net/*",
    "*://bidswitch.net/*",
    "*://*.bidswitch.net/*",
    "*://sonobi.com/*",
    "*://*.sonobi.com/*",
    "*://districtm.io/*",
    "*://*.districtm.io/*",
    "*://yieldmo.com/*",
    "*://*.yieldmo.com/*",
    "*://adlightning.com/*",
    "*://*.adlightning.com/*",
    "*://confiant-integrations.net/*",
    "*://*.confiant-integrations.net/*",
    "*://hotjar.com/*",
    "*://*.hotjar.com/*",
    "*://fullstory.com/*",
    "*://*.fullstory.com/*",
    "*://mouseflow.com/*",
    "*://*.mouseflow.com/*",
    "*://clarity.ms/*",
    "*://*.clarity.ms/*",
    "*://segment.io/*",
    "*://*.segment.io/*",
    "*://segment.com/*",
    "*://*.segment.com/*",
    "*://mixpanel.com/*",
    "*://*.mixpanel.com/*",
    "*://amplitude.com/*",
    "*://*.amplitude.com/*",
    "*://branch.io/*",
    "*://*.branch.io/*",
    "*://newrelic.com/*",
    "*://*.newrelic.com/*",
    "*://nr-data.net/*",
    "*://*.nr-data.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "learncpp_network",
        "enabled": true,
        "path": "rules/learncpp.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://learncpp.com/*",
        "*://*.learncpp.com/*"
      ],
      "css": [
        "styles/learncpp.css"
      ],
      "run_at": "document_start"
    }
  ]
}
